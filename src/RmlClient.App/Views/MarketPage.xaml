<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RmlClient.App.Views.MarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 搜索 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextStyle}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchBoxStyle}"
                         Width="240"
                         TextChanged="OnSearchChanged" />
                <Button x:Name="RefreshButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="34" Padding="14,0"
                        Click="OnRefreshClick" />
            </StackPanel>
        </Grid>

            <!-- 分类筛选 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CategoryPanel" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>

        <!-- 列表 -->
        <Grid Grid.Row="2">
            <GridView x:Name="ModsGrid"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      Padding="0,0,14,0"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="4"
                                       ItemWidth="248"
                                       ItemHeight="196" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <TextBlock Text="&#xE719;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="34"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyHint" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                <Button x:Name="EmptyRefreshButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="36" Padding="18,0"
                        HorizontalAlignment="Center"
                        Click="OnRefreshClick" />
            </StackPanel>

            <!-- 加载遮罩 -->
            <Border x:Name="LoadingOverlay"
                    Visibility="Collapsed"
                    Background="#CCF5F7FA"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                    <ProgressRing IsActive="True" Width="36" Height="36"
                                  Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="LoadingText" Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
