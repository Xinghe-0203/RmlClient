<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RmlClient.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="20" MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- ===== 主视觉：游戏卡片 ===== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid MinHeight="220">
                    <!-- 背景装饰渐变（浅色：极淡的青蓝） -->
                    <Border CornerRadius="{StaticResource CardCornerRadius}"
                            Background="{StaticResource HeroBrush}" />

                    <Grid Padding="28,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock x:Name="GreetingText"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Text="RAFT MOD LOADER" />
                            <TextBlock x:Name="HeadlineText"
                                       Style="{StaticResource HeadlineTextStyle}"
                                       Text="准备启航" />
                            <TextBlock x:Name="SubtitleText"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       MaxWidth="520"
                                       HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- 状态胶囊 -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,18,0,18">
                            <Border x:Name="CorePill" Style="{StaticResource InsetCardStyle}" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="&#xE7B8;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CoreVersionText"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="InjectionPill" Style="{StaticResource InsetCardStyle}" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="&#xE72E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="InjectionText"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ModsPill" Style="{StaticResource InsetCardStyle}" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{StaticResource WarningBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ModsCountText"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 操作区 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PlayButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="180"
                                    Height="44"
                                    Click="OnPlayClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE768;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="PlayButtonText"
                                               Text="启动游戏"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="CheckUpdateButton"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Height="44"
                                    Padding="18,0"
                                    Click="OnCheckUpdateClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="&#xE895;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CheckUpdateText"
                                               Text="检查更新"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 更新提示条 ===== -->
            <Border x:Name="UpdateBanner"
                    Visibility="Collapsed"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    BorderThickness="1"
                    Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Name="UpdateTitle"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="UpdateChangelog"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   MaxHeight="64" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="36"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            Content="立即更新"
                            Click="OnInstallUpdateClick" />
                </Grid>
            </Border>

            <!-- ===== 进度 ===== -->
            <Border x:Name="ProgressCard"
                    Visibility="Collapsed"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ProgressLabel"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="SemiBold" />
                    <ProgressBar x:Name="ProgressBar"
                                 Style="{StaticResource AccentProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ===== 环境信息 ===== -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 游戏路径 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="GamePathHeader"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Text="游戏目录" />
                        <TextBlock x:Name="GamePathText"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="DetectButton"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Height="34"
                                    Padding="14,0"
                                    Content="自动检测"
                                    Click="OnDetectClick" />
                            <Button x:Name="BrowseButton"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Height="34"
                                    Padding="14,0"
                                    Content="浏览…"
                                    Click="OnBrowseClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 注入状态 -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="InjectionHeader"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Text="加载器状态" />
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="InjectionStateText"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="InjectionDetailText"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RepairButton"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Height="34"
                                    Padding="14,0"
                                    Content="修复"
                                    Click="OnRepairClick" />
                            <Button x:Name="RemoveInjectionButton"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Height="34"
                                    Padding="14,0"
                                    Content="移除"
                                    Click="OnRemoveInjectionClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
