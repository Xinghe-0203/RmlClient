<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RmlClient.App.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextStyle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchBoxStyle}"
                         Width="220"
                         PlaceholderText="搜索已安装的 mod"
                         TextChanged="OnSearchChanged" />
                <Button x:Name="CheckUpdatesButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="34" Padding="14,0"
                        Click="OnCheckUpdatesClick" />
                <Button x:Name="OpenFolderButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="34" Padding="14,0"
                        Click="OnOpenFolderClick" />
                <Button x:Name="RefreshButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="34" Padding="14,0"
                        Click="OnRefreshClick" />
            </StackPanel>
        </Grid>

        <!-- 更新提示条：检查出有新版本时才显示 -->
        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                CornerRadius="{StaticResource ControlCornerRadius}"
                BorderBrush="{StaticResource SuccessBrush}"
                BorderThickness="1"
                Background="{StaticResource SurfaceAltBrush}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE895;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdateBannerText"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="UpdateAllButton"
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="30" Padding="14,0" FontSize="12"
                        Click="OnUpdateAllClick" />
            </Grid>
        </Border>

        <!-- 冲突提示条：只在检出冲突时显示 -->
        <Border x:Name="ConflictBanner"
                Grid.Row="2"
                Visibility="Collapsed"
                CornerRadius="{StaticResource ControlCornerRadius}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                Background="{StaticResource SurfaceAltBrush}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ConflictBannerText"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="ConflictDetailsButton"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="30" Padding="14,0" FontSize="12"
                        Click="OnConflictDetailsClick" />
            </Grid>
        </Border>

        <!-- 拖入提示 -->
        <Border x:Name="DropHint"
                Grid.Row="3"
                CornerRadius="{StaticResource ControlCornerRadius}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="&#xE896;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="DropHintText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 列表 -->
        <Grid Grid.Row="4">
            <ListView x:Name="ModsList"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <!-- 右侧留出滚动条宽度，否则条会压在卡片边缘上 -->
                        <Setter Property="Margin" Value="0,0,14,8" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <TextBlock Text="&#xE8B7;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="34"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle"
                           Style="{StaticResource BodyTextStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyHint"
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
