<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RmlClient.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 工具 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="TitleText"
                       Style="{StaticResource TitleTextStyle}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <CheckBox x:Name="AutoScrollCheck"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Checked="OnAutoScrollChanged"
                          Unchecked="OnAutoScrollChanged" />
                <Button x:Name="ClearButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="34" Padding="14,0"
                        Click="OnClearClick" />
                <Button x:Name="ExportButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="34" Padding="14,0"
                        Click="OnExportClick" />
            </StackPanel>
        </Grid>

        <!-- 标签页切换 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ClientTab" Height="32" Padding="16,0" FontSize="12"
                    CornerRadius="16" Click="OnTabClick" Tag="client" />
            <Button x:Name="LoaderTab" Height="32" Padding="16,0" FontSize="12"
                    CornerRadius="16" Click="OnTabClick" Tag="loader" />
            <Button x:Name="GameTab" Height="32" Padding="16,0" FontSize="12"
                    CornerRadius="16" Click="OnTabClick" Tag="game" />
            <TextBlock x:Name="FilterHint"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </StackPanel>

        <!-- 过滤：级别 + 关键词 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="LevelCombo"
                      MinWidth="130" Height="32" FontSize="12"
                      VerticalAlignment="Center"
                      SelectionChanged="OnLevelFilterChanged" />
            <TextBox x:Name="SearchBox"
                     Width="240" Height="32" FontSize="12"
                     VerticalAlignment="Center"
                     TextChanged="OnSearchTextChanged" />
        </StackPanel>

        <!-- 日志区 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <ScrollViewer x:Name="LogScroll"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16,14"
                              IsTabStop="False">
                    <!-- 用 RichTextBlock 而不是 TextBlock：需要按级别给每一行上色，
                         单个 TextBlock 只能有一个前景色。 -->
                    <RichTextBlock x:Name="LogRich"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="NoWrap" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Visibility="Collapsed"
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
            </Grid>
        </Border>
    </Grid>
</Page>
