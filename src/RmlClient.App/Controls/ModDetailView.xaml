<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RmlClient.App.Controls.ModDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="0,0,8,0">

            <!-- 头部：图标 + 标题 + 作者 -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost"
                        Width="56" Height="56"
                        CornerRadius="12"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="IconFallback"
                               Text="&#xE719;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource TitleTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock x:Name="SubtitleText"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>
            </Grid>

            <!-- 翻译控制条 -->
            <Border Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="12,8,12,8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TranslateLabel"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <ComboBox x:Name="LanguageCombo"
                              Grid.Column="1"
                              MinWidth="150"
                              Height="30"
                              FontSize="12"
                              SelectionChanged="OnLanguageChanged" />

                    <TextBlock x:Name="TranslateStatus"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </Grid>
            </Border>

            <!-- 描述 -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="DescriptionHeader"
                           Style="{StaticResource SectionLabelStyle}" />
                <TextBlock x:Name="DescriptionText"
                           FontSize="13"
                           LineHeight="21"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </StackPanel>

            <!-- 更新日志 -->
            <StackPanel x:Name="ChangelogSection" Spacing="6">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ChangelogHeader"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionLabelStyle}" />

                    <ComboBox x:Name="VersionCombo"
                              Grid.Column="1"
                              MinWidth="160"
                              Height="28"
                              FontSize="11.5"
                              SelectionChanged="OnVersionChanged" />
                </Grid>

                <TextBlock x:Name="ChangelogText"
                           FontSize="12.5"
                           LineHeight="20"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </StackPanel>

            <!-- 底部操作区（由调用方填充） -->
            <StackPanel x:Name="ActionHost" Spacing="10" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
